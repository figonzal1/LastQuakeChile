<resources>

    <!--
       PARTICULAR
       DESDE AQUI A ABAJO
   -->
    <style name="AppTheme" parent="BaseTheme">

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <!-- Not set previously: fell back to the M2 dark default (opaque black), silently
             breaking anything that read ?attr/colorOnSecondary instead of @color/colorOnSecondary. -->
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Toolbar Style -->
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>

        <!-- Material Button Dark Style -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>

        <!-- Snackbar style -->
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

    </style>

    <!-- Button dark style -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">

        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Button</item>
        <item name="android:textAppearance">?attr/textAppearanceButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LastQuakeChile.Button</item>
    </style>

    <style name="ThemeOverlay.App.Button" parent="">
        <item name="colorPrimary">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/colorOnSecondary</item>
    </style>

    <!--
        Outlined button style. The stock Widget.MaterialComponents.Button.OutlinedButton reads
        colorPrimary for its text/stroke, which in values-night/colors.xml is a dark navy
        (#253561) - nearly invisible on a bottom sheet's dark surface. toggle_accent/
        toggle_stroke_unchecked are dedicated tokens tuned for contrast in both themes instead.
    -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAppearance">?attr/textAppearanceButton</item>
        <item name="android:textColor">@color/toggle_accent</item>
        <item name="strokeColor">@color/toggle_stroke_unchecked</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LastQuakeChile.Button</item>
    </style>

    <style name="Widget.App.Button.Outlined.Icon">
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/toggle_accent</item>
    </style>

    <!-- Segmented toggle (e.g. the share sheet's design picker): checked/unchecked colors come
         from ColorStateLists so MaterialButtonToggleGroup's checked state is legible in both
         themes without a materialThemeOverlay. -->
    <style name="Widget.App.Button.Toggle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAppearance">?attr/textAppearanceButton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/toggle_text_color</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="strokeColor">@color/toggle_stroke_color</item>
        <item name="backgroundTint">@color/toggle_background_tint</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="rippleColor">@color/toggle_accent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LastQuakeChile.Button</item>
    </style>

    <!-- Toolbar Theming Dark -->
    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar" parent="">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnSurface</item>
    </style>

    <style name="Widget.App.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Snackbar</item>
        <item name="actionTextColorAlpha">1</item>
    </style>

    <style name="ThemeOverlay.App.Snackbar" parent="">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnSurface">@color/white</item>
    </style>


</resources>