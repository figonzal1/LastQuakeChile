<?xml version="1.0" encoding="utf-8"?>
<!-- state_enabled must come before state_checked: MaterialButton's disabled selectors
     multiply the resolved color by 0.38, so an explicit disabled entry is needed to avoid
     falling through to a checked/unchecked color that then goes near-invisible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.38"
        android:color="@color/toggle_text_unchecked"
        android:state_enabled="false" />
    <item
        android:color="@color/toggle_accent"
        android:state_checked="true" />
    <item android:color="@color/toggle_text_unchecked" />
</selector>
